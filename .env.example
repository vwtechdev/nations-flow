# ============================================================
# Nations Flow - exemplo de variáveis de ambiente
# Copie para .env e preencha os valores reais:
#   cp .env.example .env
# O arquivo .env é gitignored e NUNCA deve ser commitado.
# ============================================================

# ----- Docker Compose -----
# Nome do projeto (usado em nomes de rede, volumes e labels do Traefik)
COMPOSE_PROJECT_NAME=nations-flow
# Domínio principal (Traefik routing + CSRF_TRUSTED_ORIGINS)
DOMAIN=example.com

# ----- Django -----
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# True ou False (NUNCA True em produção)
DEBUG=False
# Hosts permitidos, separados por vírgula (ex.: example.com,www.example.com)
ALLOWED_HOSTS=example.com,www.example.com
# Senha padrão para novos usuários criados pelo sistema
DEFAULT_USER_PASSWORD=
# Email do sistema oculto (não aparece em logs de acesso)
SYSTEM_HIDDEN_EMAIL=
# URL do grupo WhatsApp (exposto em templates via context processor) - opcional
WHATSAPP_GROUP_URL=

# ----- PostgreSQL -----
POSTGRES_DB=nations-flow
POSTGRES_USER=nations-flow
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Dias de retenção dos backups (cron)
BACKUP_RETENTION_DAYS=10

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ----- reCAPTCHA v3 -----
# RECAPTCHA_DOMAIN é obrigatória — sem ela o django-recaptcha derruba o app com ImproperlyConfigured.
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
RECAPTCHA_DOMAIN=www.google.com
# Score mínimo (0.0 a 1.0, recomendado 0.5)
RECAPTCHA_REQUIRED_SCORE=0.5

# ----- Fuso horário (container cron) -----
TZ=America/Sao_Paulo